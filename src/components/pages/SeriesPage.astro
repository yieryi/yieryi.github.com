---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WritingRow from '../WritingRow.astro';
import { localizePath, type Lang } from '../../i18n/utils';

interface Props {
  series: string;
  posts: CollectionEntry<'blog'>[];
  lang: Lang;
}

const { series, posts, lang } = Astro.props;
---

<BaseLayout
  lang={lang}
  title={lang === 'zh' ? `系列：${series}` : `Series: ${series}`}
  description={
    lang === 'zh'
      ? `${series} 系列文章，共 ${posts.length} 篇。`
      : `${posts.length} articles in the ${series} series.`
  }
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <div class="breadcrumb breadcrumb-dark">
        <a href={localizePath('/writing/', lang)}>{lang === 'zh' ? '文章' : 'Writing'}</a>
        <span>/</span>
        <span>{lang === 'zh' ? '系列' : 'Series'}</span>
      </div>
      <span class="eyebrow">{lang === 'zh' ? '系列' : 'Series'}</span>
      <h1>{series}</h1>
      <p>
        {lang === 'zh' ? `同一主题下的文章集合，共 ${posts.length} 篇。` : `${posts.length} articles on the same theme.`}
      </p>
    </div>
  </section>

  <section class="page-body">
    <div class="container">
      <div class="writing-list">
        {posts.map((post) => <WritingRow post={post} lang={lang} />)}
      </div>
      <div style="margin-top: 32px;">
        <a class="text-link" href={localizePath('/writing/', lang)}>
          ← {lang === 'zh' ? '返回全部文章' : 'All articles'}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>