---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WritingRow from '../WritingRow.astro';
import { localizePath, type Lang } from '../../i18n/utils';
import { tagLabel } from '../../i18n/tags';

interface Props {
  tag: string;
  posts: CollectionEntry<'blog'>[];
  lang: Lang;
}

const { tag, posts, lang } = Astro.props;
const displayTag = tagLabel(tag, lang);
---

<BaseLayout
  lang={lang}
  title={lang === 'zh' ? `标签：${tag}` : `Tag: ${displayTag}`}
  description={lang === 'zh' ? `与 ${tag} 相关的技术文章。` : `Articles tagged ${displayTag}.`}
  noIndex={posts.length < 2}
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <div class="breadcrumb breadcrumb-dark">
        <a href={localizePath('/writing/', lang)}>{lang === 'zh' ? '文章' : 'Writing'}</a>
        <span>/</span>
        <span>{lang === 'zh' ? '标签' : 'Tag'}</span>
      </div>
      <span class="eyebrow">{lang === 'zh' ? '标签' : 'Tag'}</span>
      <h1>#{displayTag}</h1>
      <p>
        {lang === 'zh' ? `与「${tag}」相关的文章，共 ${posts.length} 篇。` : `${posts.length} article${posts.length > 1 ? 's' : ''} tagged “${displayTag}”.`}
      </p>
    </div>
  </section>

  <section class="page-body">
    <div class="container">
      <div class="writing-list">
        {posts.map((post) => <WritingRow post={post} lang={lang} />)}
      </div>
      <div style="margin-top: 32px;">
        <a class="text-link" href={localizePath('/writing/', lang)}>
          ← {lang === 'zh' ? '返回全部文章' : 'All articles'}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>