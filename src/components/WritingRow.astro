---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { formatDate, isoDate, readingTime, tagHref } from '../utils/content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;
const minutes = readingTime(post.body);
---

<article
  class="writing-row"
  data-title={data.title.toLowerCase()}
  data-description={data.description.toLowerCase()}
  data-category={data.category}
  data-tags={data.tags.join(' ')}
>
  <time class="writing-date" datetime={isoDate(data.date)}>{formatDate(data.date)}</time>

  <div class="writing-main">
    <a href={`/writing/${post.id}/`}>
      <h3 class="writing-title">{data.title}</h3>
    </a>
    <p class="writing-desc">{data.description}</p>
    <div class="writing-tags">
      <span class="tag tag-accent">{data.category}</span>
      {data.tags
        .filter((tag) => tag !== data.category)
        .slice(0, 3)
        .map((tag) => (
          <a class="tag" href={tagHref(tag)}>{tag}</a>
        ))}
    </div>
  </div>

  <div class="writing-side">
    <span>{minutes} min</span>
    <a class="writing-arrow" href={`/writing/${post.id}/`} aria-label={`阅读：${data.title}`}>
      <Icon name="arrow-right" size={14} />
    </a>
  </div>
</article>