---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { formatDate, isoDate, readingTime, seriesHref, tagHref } from '../../utils/content';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const minutes = readingTime(post.body);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const allPosts = (await getCollection('blog', ({ data: postData }) => !postData.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const index = allPosts.findIndex((item) => item.id === post.id);
const previous = allPosts[index + 1];
const next = allPosts[index - 1];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: isoDate(data.date),
  dateModified: isoDate(data.updated ?? data.date),
  author: {
    '@type': 'Person',
    name: '王康',
    alternateName: 'WANGKANG',
    url: site.url,
  },
  publisher: {
    '@type': 'Person',
    name: '王康',
  },
  mainEntityOfPage: `https://yieryi.github.io/writing/${post.id}/`,
  keywords: data.tags.join(', '),
  articleSection: data.category,
  inLanguage: 'zh-CN',
};
---

<BaseLayout title={data.title} description={data.description} type="article" schema={articleSchema}>
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

  <header class="post-header">
    <div class="container post-header-inner">
      <div class="post-kicker">
        <a href="/writing/">Writing</a>
        <span>/</span>
        <span>{data.category}</span>
        {data.series && (
          <>
            <span>/</span>
            <a href={seriesHref(data.series)}>{data.series}</a>
          </>
        )}
      </div>

      <h1 class="post-title">{data.title}</h1>
      <p class="post-description">{data.description}</p>

      <div class="post-meta">
        <span>{formatDate(data.date, 'long')}</span>
        <span class="post-meta-dot"></span>
        <span>{minutes} 分钟阅读</span>
        {data.updated && (
          <>
            <span class="post-meta-dot"></span>
            <span>更新于 {formatDate(data.updated, 'long')}</span>
          </>
        )}
      </div>
    </div>
  </header>

  <section class="page-body" style="padding-top: 8px;">
    <div class="container">
      <div class="post-layout">
        <div class="post-content">
          <article class="prose">
            <Content />
          </article>

          <footer class="post-footer">
            <div class="post-footer-head">
              <div>
                <span class="eyebrow" style="margin-bottom: 10px;">Tags</span>
                <div class="post-tags">
                  {data.tags.map((tag) => <a class="tag" href={tagHref(tag)}>{tag}</a>)}
                </div>
                {data.updated && (
                  <p class="post-updated">
                    最后更新：{formatDate(data.updated, 'long')}
                  </p>
                )}
              </div>
              <div class="post-footer-actions">
                <a class="btn btn-outline" href={site.githubIssues} target="_blank" rel="noopener noreferrer">
                  在 GitHub 讨论
                  <Icon name="arrow-up-right" size={14} />
                </a>
                <a class="btn btn-dark" href="/writing/">
                  全部文章
                  <Icon name="arrow-right" size={14} />
                </a>
              </div>
            </div>

            <nav class="post-nav" aria-label="文章导航">
              {previous && (
                <a href={`/writing/${previous.id}/`}>
                  <span class="post-nav-direction">← 上一篇</span>
                  <span class="post-nav-title">{previous.data.title}</span>
                </a>
              )}
              {next && (
                <a href={`/writing/${next.id}/`}>
                  <span class="post-nav-direction">下一篇 →</span>
                  <span class="post-nav-title">{next.data.title}</span>
                </a>
              )}
            </nav>
          </footer>
        </div>

        <aside class="toc" aria-label="文章目录">
          <h2>On this page</h2>
          {toc.length > 0 ? (
            <ul>
              {toc.map((heading) => (
                <li class={`depth-${heading.depth}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="toc-empty">这篇文章没有小标题。</p>
          )}
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const bar = document.querySelector<HTMLElement>('#reading-progress');
  const content = document.querySelector<HTMLElement>('.post-content');

  if (bar && content) {
    const update = () => {
      const rect = content.getBoundingClientRect();
      const total = rect.height - window.innerHeight * 0.4;
      const scrolled = Math.min(Math.max(-rect.top + window.innerHeight * 0.2, 0), Math.max(total, 1));
      const progress = total > 0 ? (scrolled / total) * 100 : 0;
      bar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }
</script>