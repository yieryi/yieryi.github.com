---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import { downloads } from '../../data/downloads';
import { type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = {
  zh: {
    eyebrow: 'Downloads · Resources',
    title: '一些可以直接拿走的东西。',
    desc: '示例数据、演示视频和工具索引。文件尽量保持小而有用；较大的资源后续会放到 GitHub Releases。',
    meta: ['个资源', 'GeoJSON / JSON / MP4', '持续更新'],
    sectionEyebrow: '01 · Files',
    sectionTitle: '资源列表',
    sectionDesc: '每个文件都标注类型、大小、版本和 SHA256。下载后可自行校验完整性。',
    size: '大小',
    updated: '更新',
    type: '类型',
    download: '下载',
    noteTitle: '关于大文件：',
    note: '超过 20MB 的资源建议放在 GitHub Releases，而不是直接提交到仓库。这样既不会拖慢构建，也方便版本管理和回滚。如果你需要某个示例的原始工程或数据，可以在 GitHub Issues 留言。',
  },
  en: {
    eyebrow: 'Downloads · Resources',
    title: 'A few things you can take with you.',
    desc: 'Sample data, demo videos and a tool index. Files are kept small and useful; larger assets will move to GitHub Releases.',
    meta: ['resources', 'GeoJSON / JSON / MP4', 'Continuously updated'],
    sectionEyebrow: '01 · Files',
    sectionTitle: 'Resources',
    sectionDesc: 'Every file lists type, size, version and SHA256 so you can verify it after download.',
    size: 'Size',
    updated: 'Updated',
    type: 'Type',
    download: 'Download',
    noteTitle: 'About large files: ',
    note: 'Assets over 20MB should live in GitHub Releases rather than the repository. That keeps builds fast and versions easy to manage. If you need the original project or data behind a demo, leave a note in GitHub Issues.',
  },
} as const;

const c = copy[lang];
---

<BaseLayout
  lang={lang}
  title={lang === 'zh' ? '下载' : 'Downloads'}
  description={
    lang === 'zh'
      ? '萧安（WANGKANG）的示例数据、Cesium 演示视频与工具资源下载。'
      : 'Download XIAO AN (WANGKANG)’s sample data, Cesium demo videos and tool resources.'
  }
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <span class="eyebrow">{c.eyebrow}</span>
      <h1>{c.title}</h1>
      <p>{c.desc}</p>
      <div class="page-hero-meta">
        <span class="tag tag-dark">{downloads.length} {c.meta[0]}</span>
        <span class="tag tag-dark">{c.meta[1]}</span>
        <span class="tag tag-dark">{c.meta[2]}</span>
      </div>
    </div>
  </section>

  <section class="page-body">
    <div class="container">
      <div class="section-head reveal">
        <div class="section-head-copy">
          <span class="eyebrow">{c.sectionEyebrow}</span>
          <h2 class="section-title">{c.sectionTitle}</h2>
          <p class="section-desc">{c.sectionDesc}</p>
        </div>
      </div>

      <div class="download-grid">
        {downloads.map((item) => {
          const title = lang === 'zh' ? item.title : item.titleEn;
          const description = lang === 'zh' ? item.description : item.descriptionEn;
          const tags = lang === 'zh' ? item.tags : item.tagsEn;
          return (
            <article class="download-card reveal">
              <div class="download-card-top">
                <span class="download-type">{item.type}</span>
                <span class="tag">v{item.version}</span>
              </div>

              <h3 class="download-title">{title}</h3>
              <p class="download-desc">{description}</p>

              <dl class="download-meta">
                <div>
                  <dt>{c.size}</dt>
                  <dd>{item.size}</dd>
                </div>
                <div>
                  <dt>{c.updated}</dt>
                  <dd>{item.updated}</dd>
                </div>
                <div>
                  <dt>{c.type}</dt>
                  <dd>{item.type}</dd>
                </div>
              </dl>

              {item.sha256 && (
                <p class="download-hash">SHA256: {item.sha256.slice(0, 24)}…</p>
              )}

              <div class="download-tags">
                {tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>

              <a class="download-action" href={item.file} download>
                <span>{c.download}</span>
                <Icon name="download" size={15} />
              </a>
            </article>
          );
        })}
      </div>

      <div class="download-note reveal">
        <strong>{c.noteTitle}</strong>{c.note}
      </div>
    </div>
  </section>
</BaseLayout>