---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { useTranslations, localizePath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const displayName = lang === 'zh' ? site.name : site.nameEn;
const year = new Date().getFullYear();

const navKeys: Record<string, 'nav.work' | 'nav.writing' | 'nav.lab' | 'nav.downloads' | 'nav.about'> = {
  '/work/': 'nav.work',
  '/writing/': 'nav.writing',
  '/lab/': 'nav.lab',
  '/downloads/': 'nav.downloads',
  '/about/': 'nav.about',
};
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-cta">
      <h2 class="footer-title">
        {t('footer.cta1')}<br />
        <a href={`mailto:${site.email}`}>{t('footer.cta2')}</a>{t('footer.cta3')}
      </h2>
      <a class="btn btn-primary" href={`mailto:${site.email}`}>
        {t('footer.ctaButton')}
        <Icon name="arrow-up-right" size={16} />
      </a>
    </div>

    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={localizePath('/', lang)}>
          <span class="brand-mark" aria-hidden="true"><span>XA</span></span>
          <span class="brand-text">
            <span class="brand-name">{displayName}</span>
            <span class="brand-sub">{site.handle}</span>
          </span>
        </a>
        <p>{t('footer.desc')}</p>
      </div>

      <div class="footer-col">
        <h3>{t('footer.explore')}</h3>
        <ul>
          {site.nav.map((item) => (
            <li><a href={localizePath(item.href, lang)}>{t(navKeys[item.href])}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h3>{t('footer.elsewhere')}</h3>
        <ul>
          <li>
            <a href={site.github} target="_blank" rel="noopener noreferrer">
              {t('footer.github')}
            </a>
          </li>
          <li>
            <a href={site.githubIssues} target="_blank" rel="noopener noreferrer">
              {t('footer.guestbook')}
            </a>
          </li>
          <li><a href={localizePath('/rss.xml', lang)}>RSS</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3>{t('footer.contact')}</h3>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><span>{t('footer.wechat')}: {site.wechat}</span></li>
          <li><a href={site.githubIssues} target="_blank" rel="noopener noreferrer">{t('footer.guestbook')}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {site.name}. {t('footer.copyright')}</span>
      <span>{t('footer.built')}</span>
    </div>
  </div>
</footer>