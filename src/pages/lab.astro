---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const demoRows = [
  { title: '第一人称视角交互漫游', group: '交互与场景', note: '相机碰撞、贴地行走' },
  { title: '几何编辑', group: '交互与场景', note: '点/线/面编辑与实时更新' },
  { title: '天际线', group: '渲染与特效', note: '个人实现' },
  { title: '管线流向可视化', group: '业务管线', note: '箭头样式与流向动画' },
  { title: '城市内涝模拟', group: '业务管线', note: '热力图、降雨与河流联动' },
  { title: '北斗卫星运行轨迹', group: '业务管线', note: '轨道、时间轴与位置推演' },
];
---

<BaseLayout
  title="Lab"
  description="王康（WANGKANG）的空间计算小工具：WGS84 / GCJ02 / BD09 坐标转换，XYZ / TMS 瓦片计算，Cesium 示例索引。"
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <span class="eyebrow">Lab · Spatial Utilities</span>
      <h1>把常用的空间计算，<br />做成顺手的小工具。</h1>
      <p>
        不需要后端，打开就能用。坐标转换和瓦片计算是日常最常碰到的两件事，
        先把它们做好，后面再补 GeoJSON 校验、模型查看器之类的功能。
      </p>
      <div class="page-hero-meta">
        <span class="tag tag-dark">Coordinate</span>
        <span class="tag tag-dark">Tile</span>
        <span class="tag tag-dark">Cesium</span>
        <span class="tag tag-dark">Client-side only</span>
      </div>
    </div>
  </section>

  <section class="page-body">
    <div class="container">
      <div class="lab-grid">
        <section class="tool-panel reveal" id="coordinate">
          <h2>坐标转换</h2>
          <p>WGS84 / GCJ02 / BD09 互转，纯前端计算，适合快速核对数据。</p>

          <div class="tool-form">
            <div class="field">
              <label for="coord-lng">经度 Longitude</label>
              <input id="coord-lng" type="number" step="0.000001" value="116.397128" />
            </div>
            <div class="field">
              <label for="coord-lat">纬度 Latitude</label>
              <input id="coord-lat" type="number" step="0.000001" value="39.916527" />
            </div>
            <div class="field field-full">
              <label for="coord-source">输入坐标系</label>
              <select id="coord-source">
                <option value="wgs84">WGS84（GPS / EPSG:4326）</option>
                <option value="gcj02">GCJ02（国测局 / 高德、腾讯）</option>
                <option value="bd09">BD09（百度）</option>
              </select>
            </div>
          </div>

          <div class="tool-actions">
            <button class="btn btn-dark" type="button" id="coord-convert">转换</button>
            <button class="btn btn-outline" type="button" id="coord-reset">重置</button>
          </div>

          <div class="tool-result" id="coord-result" aria-live="polite">
            点击“转换”查看结果。
          </div>
        </section>

        <section class="tool-panel reveal" id="tile">
          <h2>瓦片计算</h2>
          <p>经纬度与 Web Mercator 瓦片号（XYZ / TMS）互算，并给出瓦片范围。</p>

          <div class="tool-form">
            <div class="field">
              <label for="tile-lng">经度 Longitude</label>
              <input id="tile-lng" type="number" step="0.000001" value="116.397128" />
            </div>
            <div class="field">
              <label for="tile-lat">纬度 Latitude</label>
              <input id="tile-lat" type="number" step="0.000001" value="39.916527" />
            </div>
            <div class="field field-full">
              <label for="tile-zoom">缩放级别 Zoom</label>
              <input id="tile-zoom" type="number" min="1" max="22" step="1" value="12" />
            </div>
          </div>

          <div class="tool-actions">
            <button class="btn btn-dark" type="button" id="tile-calc">计算</button>
            <button class="btn btn-outline" type="button" id="tile-reset">重置</button>
          </div>

          <div class="tool-result" id="tile-result" aria-live="polite">
            点击“计算”查看结果。
          </div>
        </section>
      </div>

      <div class="section-head reveal" id="demos" style="margin-top: 64px;">
        <div class="section-head-copy">
          <span class="eyebrow">01 · Cesium Demos</span>
          <h2 class="section-title">示例索引</h2>
          <p class="section-desc">
            早期 GClient / Cesium 示例的一部分。原演示环境已下线，完整索引可以在下载中心获取。
          </p>
        </div>
        <a class="text-link" href="/downloads/">
          下载完整索引
          <Icon name="download" size={14} />
        </a>
      </div>

      <div class="reveal" style="overflow-x: auto;">
        <table class="demo-table">
          <thead>
            <tr>
              <th>示例</th>
              <th>方向</th>
              <th>说明</th>
              <th>状态</th>
            </tr>
          </thead>
          <tbody>
            {demoRows.map((row) => (
              <tr>
                <td>{row.title}</td>
                <td>{row.group}</td>
                <td>{row.note}</td>
                <td><span class="status status-offline">已下线</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="download-note reveal" style="margin-top: 28px;">
        <strong>说明：</strong>
        坐标转换使用常用公开算法，BD09 与 GCJ02 的逆向为近似解，精度足够日常核对，
        但不建议用于高精度测绘成果。瓦片计算采用 Web Mercator（EPSG:3857）标准公式。
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function $<T extends HTMLElement>(selector: string): T | null {
    return document.querySelector<T>(selector);
  }
  const number = (selector: string) => Number.parseFloat(($<HTMLInputElement>(selector)?.value ?? '').trim());

  const PI = Math.PI;
  const A = 6378245.0;
  const EE = 0.00669342162296594323;
  const X_PI = (PI * 3000.0) / 180.0;

  const outOfChina = (lng: number, lat: number) =>
    !(lng > 73.66 && lng < 135.05 && lat > 3.86 && lat < 53.55);

  const transformLat = (x: number, y: number) => {
    let ret = -100.0 + 2.0 * x + 3.0 * y + 0.2 * y * y + 0.1 * x * y + 0.2 * Math.sqrt(Math.abs(x));
    ret += ((20.0 * Math.sin(6.0 * x * PI) + 20.0 * Math.sin(2.0 * x * PI)) * 2.0) / 3.0;
    ret += ((20.0 * Math.sin(y * PI) + 40.0 * Math.sin((y / 3.0) * PI)) * 2.0) / 3.0;
    ret += ((160.0 * Math.sin((y / 12.0) * PI) + 320 * Math.sin((y * PI) / 30.0)) * 2.0) / 3.0;
    return ret;
  };

  const transformLng = (x: number, y: number) => {
    let ret = 300.0 + x + 2.0 * y + 0.1 * x * x + 0.1 * x * y + 0.1 * Math.sqrt(Math.abs(x));
    ret += ((20.0 * Math.sin(6.0 * x * PI) + 20.0 * Math.sin(2.0 * x * PI)) * 2.0) / 3.0;
    ret += ((20.0 * Math.sin(x * PI) + 40.0 * Math.sin((x / 3.0) * PI)) * 2.0) / 3.0;
    ret += ((150.0 * Math.sin((x / 12.0) * PI) + 300.0 * Math.sin((x / 30.0) * PI)) * 2.0) / 3.0;
    return ret;
  };

  const wgs84ToGcj02 = (lng: number, lat: number): [number, number] => {
    if (outOfChina(lng, lat)) return [lng, lat];
    let dLat = transformLat(lng - 105.0, lat - 35.0);
    let dLng = transformLng(lng - 105.0, lat - 35.0);
    const radLat = (lat / 180.0) * PI;
    let magic = Math.sin(radLat);
    magic = 1 - EE * magic * magic;
    const sqrtMagic = Math.sqrt(magic);
    dLat = (dLat * 180.0) / (((A * (1 - EE)) / (magic * sqrtMagic)) * PI);
    dLng = (dLng * 180.0) / ((A / sqrtMagic) * Math.cos(radLat) * PI);
    return [lng + dLng, lat + dLat];
  };

  const gcj02ToWgs84 = (lng: number, lat: number): [number, number] => {
    const [gLng, gLat] = wgs84ToGcj02(lng, lat);
    return [lng * 2 - gLng, lat * 2 - gLat];
  };

  const gcj02ToBd09 = (lng: number, lat: number): [number, number] => {
    const z = Math.sqrt(lng * lng + lat * lat) + 0.00002 * Math.sin(lat * X_PI);
    const theta = Math.atan2(lat, lng) + 0.000003 * Math.cos(lng * X_PI);
    return [z * Math.cos(theta) + 0.0065, z * Math.sin(theta) + 0.006];
  };

  const bd09ToGcj02 = (lng: number, lat: number): [number, number] => {
    const x = lng - 0.0065;
    const y = lat - 0.006;
    const z = Math.sqrt(x * x + y * y) - 0.00002 * Math.sin(y * X_PI);
    const theta = Math.atan2(y, x) - 0.000003 * Math.cos(x * X_PI);
    return [z * Math.cos(theta), z * Math.sin(theta)];
  };

  const format = (value: number) => value.toFixed(6);

  const resultLine = (label: string, value: [number, number]) =>
    `<span>${label}</span> ${format(value[0])}, ${format(value[1])}`;

  const coordResult = $<HTMLElement>('#coord-result');
  const coordLng = $('#coord-lng') as HTMLInputElement | null;
  const coordLat = $('#coord-lat') as HTMLInputElement | null;
  const coordSource = $('#coord-source') as HTMLSelectElement | null;

  const convert = () => {
    const lng = number('#coord-lng');
    const lat = number('#coord-lat');
    const source = coordSource?.value ?? 'wgs84';

    if (!coordResult) return;
    if (!Number.isFinite(lng) || !Number.isFinite(lat) || Math.abs(lng) > 180 || Math.abs(lat) > 90) {
      coordResult.textContent = '请输入有效的经纬度：经度 -180 ~ 180，纬度 -90 ~ 90。';
      return;
    }

    let wgs: [number, number];
    let gcj: [number, number];
    let bd: [number, number];

    if (source === 'gcj02') {
      gcj = [lng, lat];
      wgs = gcj02ToWgs84(lng, lat);
      bd = gcj02ToBd09(lng, lat);
    } else if (source === 'bd09') {
      bd = [lng, lat];
      gcj = bd09ToGcj02(lng, lat);
      wgs = gcj02ToWgs84(gcj[0], gcj[1]);
    } else {
      wgs = [lng, lat];
      gcj = wgs84ToGcj02(lng, lat);
      bd = gcj02ToBd09(gcj[0], gcj[1]);
    }

    coordResult.innerHTML = [
      resultLine('WGS84', wgs),
      resultLine('GCJ02', gcj),
      resultLine('BD09 ', bd),
    ].join('<br />');
  };

  $('#coord-convert')?.addEventListener('click', convert);
  $('#coord-reset')?.addEventListener('click', () => {
    if (coordLng) coordLng.value = '116.397128';
    if (coordLat) coordLat.value = '39.916527';
    if (coordSource) coordSource.value = 'wgs84';
    if (coordResult) coordResult.textContent = '点击“转换”查看结果。';
  });

  const tileResult = $<HTMLElement>('#tile-result');

  const tile = () => {
    const lng = number('#tile-lng');
    const lat = number('#tile-lat');
    const zoomRaw = number('#tile-zoom');
    const zoom = Math.round(zoomRaw);

    if (!tileResult) return;
    if (
      !Number.isFinite(lng) ||
      !Number.isFinite(lat) ||
      !Number.isFinite(zoomRaw) ||
      zoom < 1 ||
      zoom > 22 ||
      Math.abs(lng) > 180 ||
      Math.abs(lat) > 85.0511
    ) {
      tileResult.textContent = '请输入有效参数：经度 -180 ~ 180，纬度 -85.0511 ~ 85.0511，层级 1 ~ 22。';
      return;
    }

    const n = 2 ** zoom;
    const x = Math.floor(((lng + 180) / 360) * n);
    const latRad = (lat * PI) / 180;
    const y = Math.floor(
      ((1 - Math.log(Math.tan(latRad) + 1 / Math.cos(latRad)) / PI) / 2) * n,
    );
    const tmsY = n - 1 - y;

    const west = (x / n) * 360 - 180;
    const east = ((x + 1) / n) * 360 - 180;
    const north = (Math.atan(Math.sinh(PI * (1 - (2 * y) / n))) * 180) / PI;
    const south = (Math.atan(Math.sinh(PI * (1 - (2 * (y + 1)) / n))) * 180) / PI;

    tileResult.innerHTML = [
      `<span>XYZ</span> z=${zoom} / x=${x} / y=${y}`,
      `<span>TMS</span> z=${zoom} / x=${x} / y=${tmsY}`,
      `<span>BBox</span> ${west.toFixed(6)}, ${south.toFixed(6)}, ${east.toFixed(6)}, ${north.toFixed(6)}`,
      `<span>Center</span> ${((west + east) / 2).toFixed(6)}, ${((south + north) / 2).toFixed(6)}`,
    ].join('<br />');
  };

  $('#tile-calc')?.addEventListener('click', tile);
  $('#tile-reset')?.addEventListener('click', () => {
    const tileLng = $('#tile-lng') as HTMLInputElement | null;
    const tileLat = $('#tile-lat') as HTMLInputElement | null;
    const tileZoom = $('#tile-zoom') as HTMLInputElement | null;
    if (tileLng) tileLng.value = '116.397128';
    if (tileLat) tileLat.value = '39.916527';
    if (tileZoom) tileZoom.value = '12';
    if (tileResult) tileResult.textContent = '点击“计算”查看结果。';
  });
</script>