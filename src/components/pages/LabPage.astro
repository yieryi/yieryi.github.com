---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import { localizePath, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  zh: {
    eyebrow: 'Lab · Spatial Utilities',
    title: '把常用的空间计算，<br />做成顺手的小工具。',
    desc: '不需要后端，打开就能用。坐标转换和瓦片计算是日常最常碰到的两件事，先把它们做好，后面再补 GeoJSON 校验、模型查看器之类的功能。',
    tags: ['Coordinate', 'Tile', 'Cesium', 'Client-side only'],
    coordTitle: '坐标转换',
    coordDesc: 'WGS84 / GCJ02 / BD09 互转，纯前端计算，适合快速核对数据。',
    longitude: '经度 Longitude',
    latitude: '纬度 Latitude',
    inputCrs: '输入坐标系',
    convert: '转换',
    reset: '重置',
    coordHint: '点击“转换”查看结果。',
    invalidCoord: '请输入有效的经纬度：经度 -180 ~ 180，纬度 -90 ~ 90。',
    tileTitle: '瓦片计算',
    tileDesc: '经纬度与 Web Mercator 瓦片号（XYZ / TMS）互算，并给出瓦片范围。',
    zoom: '缩放级别 Zoom',
    calculate: '计算',
    tileHint: '点击“计算”查看结果。',
    invalidTile: '请输入有效参数：经度 -180 ~ 180，纬度 -85.0511 ~ 85.0511，层级 1 ~ 22。',
    demosEyebrow: '01 · Cesium Demos',
    demosTitle: '示例索引',
    demosDesc:
      '早期三维引擎 / Cesium 示例的一部分。原演示环境已下线；“可看录屏”的示例已经整理成站内录屏，可以直接在线播放。',
    viewVideos: '查看示例录屏',
    table: { demo: '示例', group: '方向', note: '说明', status: '状态' },
    offline: '仅存档',
    recorded: '可看录屏',
    noteTitle: '说明：',
    note: '“仅存档”表示原始交互演示已无法访问，只保留标题和方向；“可看录屏”会跳到录屏索引在线播放。坐标转换使用常用公开算法，BD09 与 GCJ02 的逆向为近似解，精度足够日常核对，但不建议用于高精度测绘成果。瓦片计算采用 Web Mercator（EPSG:3857）标准公式。',
    demoRows: [
      { title: '第一人称视角交互漫游', group: '交互与场景', note: '相机碰撞、贴地行走', video: false },
      { title: '几何编辑', group: '交互与场景', note: '点/线/面编辑与实时更新', video: true },
      { title: '天际线', group: '渲染与特效', note: '个人实现', video: false },
      { title: '管线流向可视化', group: '业务管线', note: '箭头样式与流向动画', video: true },
      { title: '城市内涝模拟', group: '业务管线', note: '热力图、降雨与河流联动', video: true },
      { title: '北斗卫星运行轨迹', group: '业务管线', note: '轨道、时间轴与位置推演', video: false },
    ],
  },
  en: {
    eyebrow: 'Lab · Spatial Utilities',
    title: 'Spatial utilities,<br />built to be useful.',
    desc: 'No backend required. Coordinate conversion and tile math are the two things I reach for most, so they come first. GeoJSON validation and a model viewer are next.',
    tags: ['Coordinate', 'Tile', 'Cesium', 'Client-side only'],
    coordTitle: 'Coordinate conversion',
    coordDesc: 'WGS84 / GCJ02 / BD09 conversion, entirely client-side — useful for a quick check.',
    longitude: 'Longitude',
    latitude: 'Latitude',
    inputCrs: 'Input CRS',
    convert: 'Convert',
    reset: 'Reset',
    coordHint: 'Click “Convert” to see the result.',
    invalidCoord: 'Enter a valid longitude (-180 to 180) and latitude (-90 to 90).',
    tileTitle: 'Tile calculator',
    tileDesc: 'Convert latitude/longitude to Web Mercator tile numbers (XYZ / TMS) and show the tile bounds.',
    zoom: 'Zoom level',
    calculate: 'Calculate',
    tileHint: 'Click “Calculate” to see the result.',
    invalidTile: 'Enter valid values: longitude -180 to 180, latitude -85.0511 to 85.0511, zoom 1 to 22.',
    demosEyebrow: '01 · Cesium Demos',
    demosTitle: 'Demo index',
    demosDesc:
      'A subset of early 3D engine / Cesium demos. The original environment is offline; demos marked “Video available” are archived as on-site recordings you can play.',
    viewVideos: 'Watch demo reels',
    table: { demo: 'Demo', group: 'Area', note: 'Notes', status: 'Status' },
    offline: 'Archive only',
    recorded: 'Video available',
    noteTitle: 'Note: ',
    note: '“Archive only” means the original interactive demo is no longer reachable and only the title and direction remain. “Video available” opens the on-site demo reel. The coordinate conversion uses common public algorithms. The inverse of BD09/GCJ02 is approximate — good enough for daily checks, not for high-precision surveying. Tile math uses the standard Web Mercator (EPSG:3857) formula.',
    demoRows: [
      { title: 'First-person navigation', group: 'Interaction', note: 'Camera collision and ground-following', video: false },
      { title: 'Geometry editing', group: 'Interaction', note: 'Point/line/polygon editing in real time', video: true },
      { title: 'Skyline', group: 'Rendering', note: 'Individual implementation', video: false },
      { title: 'Pipeline flow visualization', group: 'Pipelines', note: 'Arrow styling and flow animation', video: true },
      { title: 'Urban flood simulation', group: 'Pipelines', note: 'Heatmap, rainfall and river coupling', video: true },
      { title: 'BeiDou satellite trajectory', group: 'Pipelines', note: 'Orbit, timeline and position propagation', video: false },
    ],
  },
} as const;

const c = copy[lang];
const demoLink = localizePath('/writing/cesium-demo-index/', lang);
const messages = {
  coordHint: c.coordHint,
  tileHint: c.tileHint,
  invalidCoord: c.invalidCoord,
  invalidTile: c.invalidTile,
} as const;
---

<BaseLayout
  lang={lang}
  title="Lab"
  description={
    lang === 'zh'
      ? '萧安（WANGKANG）的空间计算小工具：WGS84 / GCJ02 / BD09 坐标转换，XYZ / TMS 瓦片计算，Cesium 示例索引。'
      : 'XIAO AN (WANGKANG)’s spatial utilities: WGS84 / GCJ02 / BD09 coordinate conversion, XYZ / TMS tile math and a Cesium demo index.'
  }
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <span class="eyebrow">{c.eyebrow}</span>
      <h1 set:html={c.title} />
      <p>{c.desc}</p>
      <div class="page-hero-meta">
        {c.tags.map((tag) => <span class="tag tag-dark">{tag}</span>)}
      </div>
    </div>
  </section>

  <section class="page-body">
    <div class="container">
      <div class="lab-grid">
        <section class="tool-panel reveal" id="coordinate">
          <h2>{c.coordTitle}</h2>
          <p>{c.coordDesc}</p>

          <div class="tool-form">
            <div class="field">
              <label for="coord-lng">{c.longitude}</label>
              <input id="coord-lng" type="number" step="0.000001" value="116.397128" />
            </div>
            <div class="field">
              <label for="coord-lat">{c.latitude}</label>
              <input id="coord-lat" type="number" step="0.000001" value="39.916527" />
            </div>
            <div class="field field-full">
              <label for="coord-source">{c.inputCrs}</label>
              <select id="coord-source">
                <option value="wgs84">WGS84 (GPS / EPSG:4326)</option>
                <option value="gcj02">GCJ02 (China / Mars)</option>
                <option value="bd09">BD09 (Baidu)</option>
              </select>
            </div>
          </div>

          <div class="tool-actions">
            <button class="btn btn-dark" type="button" id="coord-convert">{c.convert}</button>
            <button class="btn btn-outline" type="button" id="coord-reset">{c.reset}</button>
          </div>

          <div class="tool-result" id="coord-result" aria-live="polite">{c.coordHint}</div>
        </section>

        <section class="tool-panel reveal" id="tile">
          <h2>{c.tileTitle}</h2>
          <p>{c.tileDesc}</p>

          <div class="tool-form">
            <div class="field">
              <label for="tile-lng">{c.longitude}</label>
              <input id="tile-lng" type="number" step="0.000001" value="116.397128" />
            </div>
            <div class="field">
              <label for="tile-lat">{c.latitude}</label>
              <input id="tile-lat" type="number" step="0.000001" value="39.916527" />
            </div>
            <div class="field field-full">
              <label for="tile-zoom">{c.zoom}</label>
              <input id="tile-zoom" type="number" min="1" max="22" step="1" value="12" />
            </div>
          </div>

          <div class="tool-actions">
            <button class="btn btn-dark" type="button" id="tile-calc">{c.calculate}</button>
            <button class="btn btn-outline" type="button" id="tile-reset">{c.reset}</button>
          </div>

          <div class="tool-result" id="tile-result" aria-live="polite">{c.tileHint}</div>
        </section>
      </div>

      <div class="section-head reveal" id="demos" style="margin-top: 64px;">
        <div class="section-head-copy">
          <span class="eyebrow">{c.demosEyebrow}</span>
          <h2 class="section-title">{c.demosTitle}</h2>
          <p class="section-desc">{c.demosDesc}</p>
        </div>
        <a class="text-link" href={demoLink}>
          {c.viewVideos}
          <Icon name="arrow-up-right" size={14} />
        </a>
      </div>

      <div class="reveal" style="overflow-x: auto;" tabindex="0" role="region" aria-label={lang === 'zh' ? 'Cesium 示例表' : 'Cesium demo table'}>
        <table class="demo-table">
          <thead>
            <tr>
              <th>{c.table.demo}</th>
              <th>{c.table.group}</th>
              <th>{c.table.note}</th>
              <th>{c.table.status}</th>
            </tr>
          </thead>
          <tbody>
            {c.demoRows.map((row) => (
              <tr>
                <td>{row.title}</td>
                <td>{row.group}</td>
                <td>{row.note}</td>
                <td>
                  {row.video ? (
                    <a class="status status-online" href={demoLink}>{c.recorded}</a>
                  ) : (
                    <span class="status status-offline">{c.offline}</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="download-note reveal" style="margin-top: 28px;">
        <strong>{c.noteTitle}</strong>{c.note}
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ messages }}>
  function $(selector) {
    return document.querySelector(selector);
  }
  const number = (selector) => Number.parseFloat(($(selector)?.value ?? '').trim());

  const PI = Math.PI;
  const A = 6378245.0;
  const EE = 0.00669342162296594323;
  const X_PI = (PI * 3000.0) / 180.0;

  const outOfChina = (lng, lat) =>
    !(lng > 73.66 && lng < 135.05 && lat > 3.86 && lat < 53.55);

  const transformLat = (x, y) => {
    let ret = -100.0 + 2.0 * x + 3.0 * y + 0.2 * y * y + 0.1 * x * y + 0.2 * Math.sqrt(Math.abs(x));
    ret += ((20.0 * Math.sin(6.0 * x * PI) + 20.0 * Math.sin(2.0 * x * PI)) * 2.0) / 3.0;
    ret += ((20.0 * Math.sin(y * PI) + 40.0 * Math.sin((y / 3.0) * PI)) * 2.0) / 3.0;
    ret += ((160.0 * Math.sin((y / 12.0) * PI) + 320 * Math.sin((y * PI) / 30.0)) * 2.0) / 3.0;
    return ret;
  };

  const transformLng = (x, y) => {
    let ret = 300.0 + x + 2.0 * y + 0.1 * x * x + 0.1 * x * y + 0.1 * Math.sqrt(Math.abs(x));
    ret += ((20.0 * Math.sin(6.0 * x * PI) + 20.0 * Math.sin(2.0 * x * PI)) * 2.0) / 3.0;
    ret += ((20.0 * Math.sin(x * PI) + 40.0 * Math.sin((x / 3.0) * PI)) * 2.0) / 3.0;
    ret += ((150.0 * Math.sin((x / 12.0) * PI) + 300.0 * Math.sin((x / 30.0) * PI)) * 2.0) / 3.0;
    return ret;
  };

  const wgs84ToGcj02 = (lng, lat) => {
    if (outOfChina(lng, lat)) return [lng, lat];
    let dLat = transformLat(lng - 105.0, lat - 35.0);
    let dLng = transformLng(lng - 105.0, lat - 35.0);
    const radLat = (lat / 180.0) * PI;
    let magic = Math.sin(radLat);
    magic = 1 - EE * magic * magic;
    const sqrtMagic = Math.sqrt(magic);
    dLat = (dLat * 180.0) / (((A * (1 - EE)) / (magic * sqrtMagic)) * PI);
    dLng = (dLng * 180.0) / ((A / sqrtMagic) * Math.cos(radLat) * PI);
    return [lng + dLng, lat + dLat];
  };

  const gcj02ToWgs84 = (lng, lat) => {
    const [gLng, gLat] = wgs84ToGcj02(lng, lat);
    return [lng * 2 - gLng, lat * 2 - gLat];
  };

  const gcj02ToBd09 = (lng, lat) => {
    const z = Math.sqrt(lng * lng + lat * lat) + 0.00002 * Math.sin(lat * X_PI);
    const theta = Math.atan2(lat, lng) + 0.000003 * Math.cos(lng * X_PI);
    return [z * Math.cos(theta) + 0.0065, z * Math.sin(theta) + 0.006];
  };

  const bd09ToGcj02 = (lng, lat) => {
    const x = lng - 0.0065;
    const y = lat - 0.006;
    const z = Math.sqrt(x * x + y * y) - 0.00002 * Math.sin(y * X_PI);
    const theta = Math.atan2(y, x) - 0.000003 * Math.cos(x * X_PI);
    return [z * Math.cos(theta), z * Math.sin(theta)];
  };

  const format = (value) => value.toFixed(6);
  const resultLine = (label, value) => `<span>${label}</span> ${format(value[0])}, ${format(value[1])}`;

  const coordResult = $('#coord-result');
  const coordLng = $('#coord-lng');
  const coordLat = $('#coord-lat');
  const coordSource = $('#coord-source');

  const convert = () => {
    const lng = number('#coord-lng');
    const lat = number('#coord-lat');
    const source = coordSource?.value ?? 'wgs84';

    if (!coordResult) return;
    if (!Number.isFinite(lng) || !Number.isFinite(lat) || Math.abs(lng) > 180 || Math.abs(lat) > 90) {
      coordResult.textContent = messages.invalidCoord;
      return;
    }

    let wgs;
    let gcj;
    let bd;

    if (source === 'gcj02') {
      gcj = [lng, lat];
      wgs = gcj02ToWgs84(lng, lat);
      bd = gcj02ToBd09(lng, lat);
    } else if (source === 'bd09') {
      bd = [lng, lat];
      gcj = bd09ToGcj02(lng, lat);
      wgs = gcj02ToWgs84(gcj[0], gcj[1]);
    } else {
      wgs = [lng, lat];
      gcj = wgs84ToGcj02(lng, lat);
      bd = gcj02ToBd09(gcj[0], gcj[1]);
    }

    coordResult.innerHTML = [
      resultLine('WGS84', wgs),
      resultLine('GCJ02', gcj),
      resultLine('BD09 ', bd),
    ].join('<br />');
  };

  $('#coord-convert')?.addEventListener('click', convert);
  $('#coord-reset')?.addEventListener('click', () => {
    if (coordLng) coordLng.value = '116.397128';
    if (coordLat) coordLat.value = '39.916527';
    if (coordSource) coordSource.value = 'wgs84';
    if (coordResult) coordResult.textContent = messages.coordHint;
  });

  const tileResult = $('#tile-result');

  const tile = () => {
    const lng = number('#tile-lng');
    const lat = number('#tile-lat');
    const zoomRaw = number('#tile-zoom');
    const zoom = Math.round(zoomRaw);

    if (!tileResult) return;
    if (
      !Number.isFinite(lng) ||
      !Number.isFinite(lat) ||
      !Number.isFinite(zoomRaw) ||
      zoom < 1 ||
      zoom > 22 ||
      Math.abs(lng) > 180 ||
      Math.abs(lat) > 85.0511
    ) {
      tileResult.textContent = messages.invalidTile;
      return;
    }

    const n = 2 ** zoom;
    const x = Math.floor(((lng + 180) / 360) * n);
    const latRad = (lat * PI) / 180;
    const y = Math.floor(
      ((1 - Math.log(Math.tan(latRad) + 1 / Math.cos(latRad)) / PI) / 2) * n,
    );
    const tmsY = n - 1 - y;

    const west = (x / n) * 360 - 180;
    const east = ((x + 1) / n) * 360 - 180;
    const north = (Math.atan(Math.sinh(PI * (1 - (2 * y) / n))) * 180) / PI;
    const south = (Math.atan(Math.sinh(PI * (1 - (2 * (y + 1)) / n))) * 180) / PI;

    tileResult.innerHTML = [
      `<span>XYZ</span> z=${zoom} / x=${x} / y=${y}`,
      `<span>TMS</span> z=${zoom} / x=${x} / y=${tmsY}`,
      `<span>BBox</span> ${west.toFixed(6)}, ${south.toFixed(6)}, ${east.toFixed(6)}, ${north.toFixed(6)}`,
      `<span>Center</span> ${((west + east) / 2).toFixed(6)}, ${((south + north) / 2).toFixed(6)}`,
    ].join('<br />');
  };

  $('#tile-calc')?.addEventListener('click', tile);
  $('#tile-reset')?.addEventListener('click', () => {
    const tileLng = $('#tile-lng');
    const tileLat = $('#tile-lat');
    const tileZoom = $('#tile-zoom');
    if (tileLng) tileLng.value = '116.397128';
    if (tileLat) tileLat.value = '39.916527';
    if (tileZoom) tileZoom.value = '12';
    if (tileResult) tileResult.textContent = messages.tileHint;
  });
</script>