---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../ProjectCard.astro';
import Icon from '../Icon.astro';
import { localizePath, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const projects = (
  lang === 'en' ? await getCollection('projectsEn') : await getCollection('projects')
).sort((a, b) => a.data.order - b.data.order);

const copy = {
  zh: {
    eyebrow: 'Work · Selected Projects',
    title: '做过的事，<br />比技术栈更有说服力。',
    desc: '三个阶段的工程实践：桌面端数字地球、WebGL 引擎底层、高精地图与三维模型规模化生产。每个案例都按“背景 — 角色 — 关键设计 — 结果 — 复盘”展开。',
    tags: ['3D Engine', 'GIS Geometry', 'HD Map', '3D Reconstruction'],
    sectionEyebrow: '01 · Case Studies',
    sectionTitle: '工程案例',
    sectionDesc: '涉及公司业务的内容已做脱敏，只保留公开可说的技术方法、架构和个人贡献。',
    link: '查看履历',
  },
  en: {
    eyebrow: 'Work · Selected Projects',
    title: 'The work speaks<br />louder than the stack.',
    desc: 'Three stages of engineering: a desktop digital earth, a WebGL engine, and HD map / 3D model production at scale. Each case follows context, role, key design, outcome and reflection.',
    tags: ['3D Engine', 'GIS Geometry', 'HD Map', '3D Reconstruction'],
    sectionEyebrow: '01 · Case Studies',
    sectionTitle: 'Case studies',
    sectionDesc: 'Company-related content has been sanitized. Only publicly shareable methods, architecture and individual contributions are included.',
    link: 'View experience',
  },
} as const;

const c = copy[lang];
---

<BaseLayout
  lang={lang}
  title={lang === 'zh' ? '项目' : 'Work'}
  description={
    lang === 'zh'
      ? '王康（WANGKANG）的项目案例：数字地球引擎、WebGL 渲染、GIS 几何计算、高精地图与三维模型生产。'
      : 'WANGKANG — case studies on digital earth engines, WebGL rendering, GIS geometry, HD maps and 3D model production.'
  }
  image="/og/project.png"
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <span class="eyebrow">{c.eyebrow}</span>
      <h1 set:html={c.title} />
      <p>{c.desc}</p>
      <div class="page-hero-meta">
        {c.tags.map((tag) => <span class="tag tag-dark">{tag}</span>)}
      </div>
    </div>
  </section>

  <section class="page-body">
    <div class="container">
      <div class="section-head reveal">
        <div class="section-head-copy">
          <span class="eyebrow">{c.sectionEyebrow}</span>
          <h2 class="section-title">{c.sectionTitle}</h2>
          <p class="section-desc">{c.sectionDesc}</p>
        </div>
        <a class="text-link" href={localizePath('/about/', lang)}>
          {c.link}
          <Icon name="arrow-up-right" size={14} />
        </a>
      </div>

      <div class="work-grid">
        {projects.map((project) => (
          <div class="reveal"><ProjectCard project={project} lang={lang} /></div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>