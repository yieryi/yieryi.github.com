---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WritingRow from '../../components/WritingRow.astro';
import Icon from '../../components/Icon.astro';
import { readingTime, seriesHref, tagHref } from '../../utils/content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const categories = [...new Set(posts.map((post) => post.data.category))];
const series = [...new Set(posts.map((post) => post.data.series).filter(Boolean))] as string[];
const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

const seriesDescriptions: Record<string, string> = {
  'Cesium 实战': 'Label 遮挡、全景融合、Sandcastle 批量迁移，以及三维引擎示例索引。',
  前端基础: 'JavaScript 模块化、工程化与浏览器端基础能力。',
  'GIS 数据与工具': '瓦片、投影、影像下载与三维 GIS 工具链。',
};

const totalMinutes = posts.reduce((sum, post) => sum + readingTime(post.body), 0);
---

<BaseLayout
  title="Writing"
  description="王康（WANGKANG）的技术文章：Cesium、WebGL、GIS 几何计算、高精地图与三维数据生产。"
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <span class="eyebrow">Writing · Notes & Engineering</span>
      <h1>写清楚问题，<br />比秀技术更重要。</h1>
      <p>
        Cesium、WebGL、GIS 数据与前端工程。记录问题、方案和取舍，尽量让后来的人少踩一次坑。
      </p>
      <div class="page-hero-meta">
        <span class="tag tag-dark">{posts.length} 篇文章</span>
        <span class="tag tag-dark">{series.length} 个系列</span>
        <span class="tag tag-dark">{categories.length} 个分类</span>
        <span class="tag tag-dark">约 {Math.max(10, Math.round(totalMinutes / 10) * 10)} 分钟阅读</span>
      </div>
    </div>
  </section>

  <section class="page-body">
    <div class="container">
      {series.length > 0 && (
        <div class="series-grid reveal">
          {series.map((name) => {
            const count = posts.filter((post) => post.data.series === name).length;
            return (
              <a class="series-card" href={seriesHref(name)}>
                <span class="series-kicker">Series</span>
                <span class="series-title">{name}</span>
                <span class="series-desc">{seriesDescriptions[name] ?? '相关文章集合。'}</span>
                <span class="series-count">{count} 篇</span>
              </a>
            );
          })}
        </div>
      )}

      <div class="writing-toolbar">
        <label class="filter-search">
          <Icon name="search" size={16} />
          <span class="sr-only">搜索文章</span>
          <input
            id="writing-search"
            type="search"
            placeholder="搜索标题、摘要、标签…"
            autocomplete="off"
          />
        </label>

        <div class="filter-chips" role="group" aria-label="按分类筛选">
          <button class="filter-chip is-active" type="button" data-category="全部" aria-pressed="true">
            全部
          </button>
          {categories.map((category) => (
            <button class="filter-chip" type="button" data-category={category} aria-pressed="false">
              {category}
            </button>
          ))}
        </div>

        <span class="writing-count" id="writing-count">{posts.length} 篇</span>
      </div>

      <div class="writing-list" id="writing-list">
        {posts.map((post) => <WritingRow post={post} />)}
      </div>

      <div class="empty-state" id="writing-empty" hidden>
        没有匹配的文章，换个关键词或分类试试。
      </div>

      {tags.length > 0 && (
        <div style="margin-top: 48px;">
          <span class="eyebrow">Tags</span>
          <div class="tag-cloud">
            {tags.map((tag) => <a class="tag" href={tagHref(tag)}>{tag}</a>)}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.writing-row'));
  const input = document.querySelector<HTMLInputElement>('#writing-search');
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-chip'));
  const count = document.querySelector<HTMLElement>('#writing-count');
  const empty = document.querySelector<HTMLElement>('#writing-empty');
  let activeCategory = '全部';

  const applyFilter = () => {
    const query = (input?.value ?? '').trim().toLowerCase();
    let visible = 0;

    rows.forEach((row) => {
      const matchesCategory =
        activeCategory === '全部' || row.dataset.category === activeCategory;
      const haystack = [
        row.dataset.title,
        row.dataset.description,
        row.dataset.category,
        row.dataset.tags,
      ]
        .join(' ')
        .toLowerCase();
      const matchesQuery = !query || haystack.includes(query);
      const show = matchesCategory && matchesQuery;
      row.hidden = !show;
      if (show) visible += 1;
    });

    if (count) count.textContent = `${visible} 篇`;
    if (empty) empty.hidden = visible > 0;
  };

  input?.addEventListener('input', applyFilter);

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      activeCategory = chip.dataset.category ?? '全部';
      chips.forEach((item) => {
        const active = item === chip;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      applyFilter();
    });
  });
</script>