---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import { site } from '../../data/site';
import { type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  zh: {
    tip: '提示：点击右侧按钮，在浏览器打印对话框中选择“另存为 PDF”。',
    print: '打印 / 保存为 PDF',
    role: '三维地理空间工程师 · 3D Geo-Engineer',
    summary:
      '长期从事三维 GIS 工程，覆盖桌面端数字地球引擎、WebGL 引擎底层、GIS 几何计算、高精地图与三维模型生产。擅长把渲染、几何与数据生产问题拆解成可落地的系统。',
    experience: '工作经历',
    selected: '代表项目',
    skills: '技术能力',
    writing: '写作与开源',
    writingLabel: '技术写作',
    writingValue: 'Cesium、WebGL、GIS 数据与三维引擎实践',
    openSource: '开源贡献',
    openSourceValue: 'Cesium Billboard 相关 PR，三维示例与工具',
  },
  en: {
    tip: 'Tip: use the button on the right and choose “Save as PDF” in the browser print dialog.',
    print: 'Print / Save as PDF',
    role: '3D Geospatial Engineer',
    summary:
      'Long-term 3D GIS engineering across desktop digital earth engines, WebGL engine cores, GIS geometry, HD maps and 3D model production. I like turning rendering, geometry and data-production problems into systems that ship.',
    experience: 'Experience',
    selected: 'Selected Work',
    skills: 'Skills',
    writing: 'Writing & Open Source',
    writingLabel: 'Technical writing',
    writingValue: 'Cesium, WebGL, GIS data and 3D engine practice',
    openSource: 'Open source',
    openSourceValue: 'Cesium Billboard-related PR, 3D demos and tools',
  },
} as const;

const c = copy[lang];

const skills = {
  zh: [
    { label: '3D / Graphics', value: 'WebGL, GLSL, C++, OpenGL, Cesium, 3D Tiles' },
    { label: 'GIS', value: '空间分析, 几何编辑, 坐标/瓦片, 管线, 内涝模拟' },
    { label: 'Data', value: '高精地图, 三维重建, 数据生产, 质量校验' },
    { label: 'Engineering', value: 'TypeScript, Node.js, 工具链, 跨团队协调' },
  ],
  en: [
    { label: '3D / Graphics', value: 'WebGL, GLSL, C++, OpenGL, Cesium, 3D Tiles' },
    { label: 'GIS', value: 'Spatial analysis, geometry editing, coordinates/tiles, pipelines, flood simulation' },
    { label: 'Data', value: 'HD maps, 3D reconstruction, data production, quality checks' },
    { label: 'Engineering', value: 'TypeScript, Node.js, tooling, cross-team coordination' },
  ],
};

const highlights = {
  zh: [
    'GClient WebGL 数字地球引擎底层研发，建设渲染、数据接入、空间分析与业务渲染管线。',
    '高德高精地图生产编辑器提效，三维模型半自动生产流程建设，部分成果上线高德地图 App。',
    'LocaSpace Viewer 数字地球引擎功能研发，支撑交通规划、工程建设等行业项目。',
  ],
  en: [
    'Core R&D on the GClient WebGL digital earth engine: rendering, data integration, spatial analysis and business pipelines.',
    'Productivity work on the Amap HD map production editor and a semi-automated 3D model pipeline; some results are live in the Amap app.',
    'Feature R&D for the LocaSpace Viewer digital earth engine, supporting transportation planning and engineering projects.',
  ],
};
---

<BaseLayout
  lang={lang}
  title={lang === 'zh' ? '简历' : 'Resume'}
  description={
    lang === 'zh'
      ? '王康（WANGKANG）的个人简历：三维渲染引擎、GIS 几何计算、高精地图与三维重建。'
      : 'WANGKANG — resume: 3D rendering engines, GIS geometry, HD maps and 3D reconstruction.'
  }
  bodyClass="resume-body"
>
  <div class="resume-page">
    <div class="resume-actions no-print">
      <p>{c.tip}</p>
      <button class="btn btn-dark" type="button" id="print-resume">
        {c.print}
        <Icon name="printer" size={15} />
      </button>
    </div>

    <article class="resume-sheet">
      <header class="resume-header">
        <div>
          <h1 class="resume-name">王康 · WANGKANG</h1>
          <p class="resume-role">{c.role}</p>
        </div>
        <div class="resume-contact">
          <span>{site.email}</span>
          <span>github.com/yieryi</span>
          <span>{lang === 'zh' ? '微信' : 'WeChat'}: {site.wechat}</span>
          <span>yieryi.github.io</span>
        </div>
      </header>

      <p class="resume-summary">{c.summary}</p>

      <section class="resume-section">
        <h2>{c.experience}</h2>
        {site.timeline.map((item) => (
          <div class="resume-item">
            <div class="resume-item-period">{lang === 'zh' ? item.period : item.periodEn}</div>
            <div>
              <h3>{lang === 'zh' ? item.title : item.titleEn}</h3>
              <div class="resume-item-company">{lang === 'zh' ? item.company : item.companyEn}</div>
              <p>{lang === 'zh' ? item.description : item.descriptionEn}</p>
            </div>
          </div>
        ))}
      </section>

      <section class="resume-section">
        <h2>{c.selected}</h2>
        {highlights[lang].map((item) => (
          <div class="resume-item">
            <div class="resume-item-period">Project</div>
            <p>{item}</p>
          </div>
        ))}
      </section>

      <section class="resume-section">
        <h2>{c.skills}</h2>
        <div class="resume-skills">
          {skills[lang].map((skill) => (
            <div>
              <strong>{skill.label}</strong><br />
              <span>{skill.value}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="resume-section">
        <h2>{c.writing}</h2>
        <div class="resume-skills">
          <div>
            <strong>{c.writingLabel}</strong><br />
            <span>{c.writingValue}</span>
          </div>
          <div>
            <strong>{c.openSource}</strong><br />
            <span>{c.openSourceValue}</span>
          </div>
        </div>
      </section>
    </article>
  </div>
</BaseLayout>

<script>
  document.querySelector<HTMLButtonElement>('#print-resume')?.addEventListener('click', () => {
    window.print();
  });
</script>