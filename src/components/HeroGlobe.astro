<div class="hero-visual" aria-hidden="true">
  <div class="globe-fallback">
    <div class="globe-fallback-grid"></div>
  </div>
  <canvas class="globe-canvas" data-globe></canvas>
  <div class="hero-coordinate">
    <div><strong>LAT</strong> 39°54′N</div>
    <div><strong>LON</strong> 116°23′E</div>
    <div><strong>ALT</strong> 43m</div>
  </div>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-globe]');

  if (canvas) {
    let started = false;

    const boot = async () => {
      if (started) return;
      started = true;
      try {
        const { initGlobe } = await import('../scripts/globe');
        initGlobe(canvas);
      } catch {
        canvas.remove();
      }
    };

    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(boot, { timeout: 1800 });
    } else {
      setTimeout(boot, 500);
    }
  }
</script>