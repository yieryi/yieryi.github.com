---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoverArt from '../CoverArt.astro';
import Icon from '../Icon.astro';
import { site } from '../../data/site';
import { localizePath, type Lang } from '../../i18n/utils';

interface Props {
  project: CollectionEntry<'projects'> | CollectionEntry<'projectsEn'>;
  previous?: CollectionEntry<'projects'> | CollectionEntry<'projectsEn'>;
  next?: CollectionEntry<'projects'> | CollectionEntry<'projectsEn'>;
  lang: Lang;
  index: number;
  Content: any;
}

const { project, previous, next, lang, index, Content } = Astro.props;
const { data } = project;

const copy = {
  zh: {
    work: '项目',
    eyebrow: '案例 · ',
    stack: '技术栈',
    type: '类型',
    typeValue: '工程案例',
    disclaimerTitle: '关于内容：',
    disclaimer:
      '本文仅描述公开可说的技术方向、架构思路和工程实践，不包含内部数据、系统截图或未公开指标。如需进一步交流，欢迎在 GitHub 留言。',
    previous: '← 上一个项目',
    next: '下一个项目 →',
    back: '返回全部项目',
  },
  en: {
    work: 'Work',
    eyebrow: 'Case Study · ',
    stack: 'Stack',
    type: 'Type',
    typeValue: 'Case study',
    disclaimerTitle: 'About this page: ',
    disclaimer:
      'This page describes publicly shareable technical directions, architecture ideas and engineering practice. It does not include internal data, screenshots or unpublished metrics. Use GitHub Issues to get in touch.',
    previous: '← Previous project',
    next: 'Next project →',
    back: 'All projects',
  },
} as const;

const c = copy[lang];
const title = lang === 'en' ? (data.titleEn ?? data.title) : data.title;
const summary = lang === 'en' ? (data.summaryEn ?? data.summary) : data.summary;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description: summary,
  author: {
    '@type': 'Person',
    name: site.name,
    alternateName: site.handle,
  },
  keywords: data.stack.join(', '),
  inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
  url: new URL(localizePath(`/work/${project.id}/`, lang), site.url).toString(),
};
---

<BaseLayout
  lang={lang}
  title={title}
  description={summary}
  image="/og/project.png"
  type="article"
  schema={articleSchema}
>
  <section class="project-hero">
    <div class="container project-hero-grid">
      <div>
        <div class="breadcrumb breadcrumb-dark">
          <a href={localizePath('/work/', lang)}>{c.work}</a>
          <span>/</span>
          <span>{title}</span>
        </div>

        <span class="eyebrow">{c.eyebrow}0{index + 1}</span>
        <h1>{title}</h1>
        <p class="project-hero-summary">{summary}</p>

        <dl class="project-hero-meta" style="grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr);">
          <div>
            <dt>{c.stack}</dt>
            <dd>{data.stack.join(' / ')}</dd>
          </div>
          <div>
            <dt>{c.type}</dt>
            <dd>{c.typeValue}</dd>
          </div>
        </dl>
      </div>

      <CoverArt variant={data.cover} label={data.stack.slice(0, 2).join(' / ')} />
    </div>
  </section>

  <section class="project-body">
    <div class="container">
      <div class="project-article">
        <article class="prose">
          <Content />
        </article>

        <p class="project-disclaimer">
          <strong>{c.disclaimerTitle}</strong>{c.disclaimer}
        </p>

        <nav class="post-nav" aria-label={lang === 'zh' ? '项目导航' : 'Project navigation'}>
          {previous && (
            <a href={localizePath(`/work/${previous.id}/`, lang)}>
              <span class="post-nav-direction">{c.previous}</span>
              <span class="post-nav-title">
                {lang === 'en' ? (previous.data.titleEn ?? previous.data.title) : previous.data.title}
              </span>
            </a>
          )}
          {next && (
            <a href={localizePath(`/work/${next.id}/`, lang)}>
              <span class="post-nav-direction">{c.next}</span>
              <span class="post-nav-title">
                {lang === 'en' ? (next.data.titleEn ?? next.data.title) : next.data.title}
              </span>
            </a>
          )}
        </nav>

        <div style="margin-top: 32px;">
          <a class="btn btn-dark" href={localizePath('/work/', lang)}>
            {c.back}
            <Icon name="arrow-right" size={15} />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>