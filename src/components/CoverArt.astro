---
interface Props {
  variant?: 'engine' | 'gis' | 'map' | 'data';
  label?: string;
  class?: string;
}

const { variant = 'engine', label = 'SPATIAL / 01', class: className = '' } = Astro.props;
---

<div class:list={['cover-art', className]} aria-hidden="true">
  {variant === 'engine' && (
    <svg viewBox="0 0 640 400" preserveAspectRatio="xMidYMid slice">
      <g fill="none" stroke="rgba(56,232,198,.5)" stroke-width="1">
        <ellipse cx="320" cy="200" rx="150" ry="150" opacity=".45" />
        <ellipse cx="320" cy="200" rx="150" ry="52" opacity=".35" transform="rotate(-18 320 200)" />
        <ellipse cx="320" cy="200" rx="52" ry="150" opacity=".25" transform="rotate(-18 320 200)" />
        <ellipse cx="320" cy="200" rx="210" ry="72" opacity=".18" transform="rotate(24 320 200)" />
        <path d="M170 200h300M320 50v300M210 90l220 220M430 90 210 310" opacity=".18" />
        <path d="M205 130l115 70-115 70M435 130 320 200l115 70" opacity=".45" />
      </g>
      <g fill="rgba(56,232,198,.8)">
        <circle cx="205" cy="130" r="3" />
        <circle cx="320" cy="200" r="4" />
        <circle cx="435" cy="130" r="3" />
        <circle cx="205" cy="270" r="3" />
        <circle cx="435" cy="270" r="3" />
      </g>
      <g fill="none" stroke="rgba(76,141,255,.45)" stroke-width="1">
        <path d="M120 300c80-110 140-70 200-130s130-20 200-90" />
      </g>
    </svg>
  )}

  {variant === 'gis' && (
    <svg viewBox="0 0 640 400" preserveAspectRatio="xMidYMid slice">
      <g fill="none" stroke="rgba(148,163,184,.22)" stroke-width="1">
        <path d="M0 80h640M0 160h640M0 240h640M0 320h640M80 0v400M160 0v400M240 0v400M320 0v400M400 0v400M480 0v400M560 0v400" />
      </g>
      <g fill="none" stroke="rgba(56,232,198,.55)" stroke-width="1.4">
        <path d="M160 250l70-90 110 24 44 86-92 44-132-64Z" />
        <path d="M352 120l92-34 64 78-44 76-82-26-30-94Z" opacity=".55" />
      </g>
      <g fill="rgba(76,141,255,.25)" stroke="rgba(76,141,255,.65)" stroke-width="1">
        <path d="M170 248l66-82 100 22 38 78-84 40-120-58Z" />
      </g>
      <g fill="none" stroke="rgba(230,237,247,.5)" stroke-width="1">
        <circle cx="250" cy="212" r="18" />
        <path d="M250 180v64M218 212h64" />
      </g>
      <g fill="rgba(56,232,198,.9)">
        <circle cx="250" cy="212" r="3" />
        <circle cx="420" cy="150" r="3" />
        <circle cx="360" cy="290" r="3" />
      </g>
    </svg>
  )}

  {variant === 'map' && (
    <svg viewBox="0 0 640 400" preserveAspectRatio="xMidYMid slice">
      <g fill="none" stroke="rgba(148,163,184,.2)" stroke-width="1">
        <path d="M-20 310c90-40 150-10 230-60s120-80 210-60 130 30 240-10" />
        <path d="M-20 260c100-30 150 10 240-40s150-90 250-60 100 20 190-20" />
        <path d="M-20 210c100-20 170 20 250-30s150-70 240-40 120 10 190-20" />
        <path d="M-20 160c120-10 180 20 270-20s130-50 220-20 100 0 190-30" />
        <path d="M-20 110c110 0 190 10 280-20s130-30 210 0 100 0 180-20" />
      </g>
      <g fill="none" stroke="rgba(56,232,198,.6)" stroke-width="1.5">
        <path d="M90 330c70-30 80-100 150-110s70 60 140 20 70-100 170-110" />
      </g>
      <g fill="none" stroke="rgba(76,141,255,.55)" stroke-width="1.2" stroke-dasharray="5 7">
        <path d="M80 100c90 30 120 90 200 80s100-60 180-40 60 50 110 40" />
      </g>
      <g fill="rgba(56,232,198,.9)">
        <circle cx="90" cy="330" r="3.5" />
        <circle cx="240" cy="220" r="3.5" />
        <circle cx="380" cy="240" r="3.5" />
        <circle cx="550" cy="130" r="3.5" />
      </g>
      <g fill="rgba(230,237,247,.55)" font-family="monospace" font-size="10">
        <text x="76" y="352">P-01</text>
        <text x="526" y="118">P-04</text>
      </g>
    </svg>
  )}

  {variant === 'data' && (
    <svg viewBox="0 0 640 400" preserveAspectRatio="xMidYMid slice">
      <g fill="none" stroke="rgba(148,163,184,.2)" stroke-width="1">
        <path d="M60 330h520M60 270h520M60 210h520M60 150h520M60 90h520" />
        <path d="M100 60v290M220 60v290M340 60v290M460 60v290M580 60v290" />
      </g>
      <g fill="rgba(56,232,198,.18)" stroke="rgba(56,232,198,.55)" stroke-width="1">
        <rect x="120" y="230" width="54" height="100" />
        <rect x="210" y="180" width="54" height="150" />
        <rect x="300" y="120" width="54" height="210" />
        <rect x="390" y="200" width="54" height="130" />
        <rect x="480" y="90" width="54" height="240" />
      </g>
      <g fill="rgba(76,141,255,.55)">
        <circle cx="147" cy="230" r="3" />
        <circle cx="237" cy="180" r="3" />
        <circle cx="327" cy="120" r="3" />
        <circle cx="417" cy="200" r="3" />
        <circle cx="507" cy="90" r="3" />
      </g>
      <path d="M147 230 237 180 327 120 417 200 507 90" fill="none" stroke="rgba(230,237,247,.5)" stroke-width="1.2" />
    </svg>
  )}

  <span class="cover-art-label">{label}</span>
</div>