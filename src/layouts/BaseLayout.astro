---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/content.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { site } from '../data/site';
import { getLangFromUrl, useTranslations, alternatePaths, type Lang } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noIndex?: boolean;
  bodyClass?: string;
  lang?: Lang;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  lang = getLangFromUrl(Astro.url),
  title,
  description = lang === 'zh' ? site.description : site.descriptionEn,
  image = '/og/default.png',
  type = 'website',
  noIndex = false,
  bodyClass = '',
  schema,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(site.url);
const t = useTranslations(lang);
const role = lang === 'zh' ? site.role : site.roleEn;
const displayName = lang === 'zh' ? site.name : site.nameEn;
const pageTitle = title ? `${title} · ${displayName}` : `${displayName} · ${role}`;
const canonical = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL(image, siteUrl);
const alternates = alternatePaths(Astro.url.pathname);
const keywords = lang === 'zh' ? site.keywords : site.keywordsEn;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.handle,
  url: site.url,
  jobTitle: lang === 'zh' ? '高级地图工程师' : 'Senior Map Engineer',
  worksFor: {
    '@type': 'Organization',
    name: lang === 'zh' ? '高德' : 'Amap',
  },
  description: lang === 'zh' ? site.description : site.descriptionEn,
  sameAs: [site.github],
  knowsAbout: [
    '3D Rendering Engine',
    'WebGL',
    'Cesium',
    'GIS Geometry',
    'HD Map',
    '3D Reconstruction',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${displayName} · ${role}`,
  url: site.url,
  description: lang === 'zh' ? site.description : site.descriptionEn,
  inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
};

const structuredData = [personSchema, websiteSchema, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta id="theme-color-meta" name="theme-color" content="#f7f8fa" />
    <script is:inline>
      (() => {
        let theme = 'light';
        try {
          const saved = localStorage.getItem('wangkang-theme');
          if (saved === 'light' || saved === 'dark') {
            theme = saved;
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            theme = 'dark';
          }
        } catch {
          // Ignore storage access errors.
        }
        document.documentElement.dataset.theme = theme;
        document.documentElement.classList.add('has-js');
        const meta = document.getElementById('theme-color-meta');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#070b12' : '#f7f8fa');
      })();
    </script>
    <noscript>
      <style>.reveal { opacity: 1 !important; transform: none !important; }</style>
    </noscript>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={displayName} />
    <meta name="keywords" content={keywords.join(',')} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(alternates.zh, siteUrl)} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, siteUrl)} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.zh, siteUrl)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${displayName} · RSS`}
      href={lang === 'zh' ? '/rss.xml' : '/en/rss.xml'}
    />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={`${displayName} · ${role}`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{t('common.skip')}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <SearchDialog lang={lang} />

    <script>
      // Reveal sections on scroll.
      const revealItems = document.querySelectorAll<HTMLElement>('.reveal');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduceMotion || !('IntersectionObserver' in window)) {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        revealItems.forEach((item) => revealObserver.observe(item));
      }

      // Add copy buttons to code blocks.
      document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
        if (pre.parentElement?.classList.contains('code-wrap')) return;
        const wrap = document.createElement('div');
        wrap.className = 'code-wrap';
        pre.parentNode?.insertBefore(wrap, pre);
        wrap.appendChild(pre);

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'copy-code';
        button.textContent = '复制';
        button.setAttribute('aria-label', '复制代码');
        wrap.appendChild(button);

        button.addEventListener('click', async () => {
          const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
          try {
            await navigator.clipboard.writeText(code);
            button.textContent = '已复制';
          } catch {
            button.textContent = '复制失败';
          }
          window.setTimeout(() => {
            button.textContent = '复制';
          }, 1600);
        });
      });

      // Mark external links so they open safely in a new tab.
      document.querySelectorAll<HTMLAnchorElement>('a[href^="http"]').forEach((link) => {
        try {
          const url = new URL(link.href);
          if (url.hostname === window.location.hostname) return;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
        } catch {
          // Ignore malformed links.
        }
      });
    </script>
  </body>
</html>