---
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<dialog class="search-dialog" id="search-dialog" data-lang={lang} aria-label={lang === 'zh' ? '站内搜索' : 'Site search'}>
  <div class="search-input-row">
    <Icon name="search" size={18} />
    <input
      id="search-input"
      type="search"
      placeholder={t('search.placeholder')}
      autocomplete="off"
      spellcheck="false"
      aria-label={t('search.placeholder')}
    />
    <kbd>ESC</kbd>
  </div>
  <div class="search-results" id="search-results" role="listbox" aria-label={lang === 'zh' ? '搜索结果' : 'Search results'}></div>
  <div class="search-hint">
    <span>{t('search.hintUpDown')}</span>
    <span>{t('search.hintEnter')}</span>
    <span>{t('search.hintEsc')}</span>
  </div>
</dialog>

<script>
  import { ui } from '../i18n/ui';

  type SearchItem = {
    title: string;
    description: string;
    href: string;
    type: 'article' | 'project' | 'page';
    lang: 'zh' | 'en';
    date?: string;
    tags?: string[];
  };

  const dialog = document.querySelector<HTMLDialogElement>('#search-dialog');
  const input = document.querySelector<HTMLInputElement>('#search-input');
  const results = document.querySelector<HTMLElement>('#search-results');
  const lang = dialog?.dataset.lang === 'en' ? 'en' : 'zh';
  const labels = {
    empty: ui[lang]['search.empty'],
    loading: ui[lang]['search.loading'],
    article: ui[lang]['search.typeArticle'],
    project: ui[lang]['search.typeProject'],
    page: ui[lang]['search.typePage'],
  };
  let items: SearchItem[] | null = null;
  let loading = false;
  let activeIndex = -1;
  let current: SearchItem[] = [];

  const typeLabel = (item: SearchItem) => {
    const type = item.type === 'article' ? labels.article : item.type === 'project' ? labels.project : labels.page;
    const parts: string[] = [type];
    if (item.date) parts.push(item.date);
    if (item.tags?.length) parts.push(item.tags.slice(0, 2).join(' / '));
    return parts.join(' · ');
  };

  const render = (query: string) => {
    if (!results) return;
    const q = query.trim().toLowerCase();
    const all = (items ?? []).filter((item) => item.lang === lang);
    current = q
      ? all.filter((item) => {
          const haystack = [item.title, item.description, ...(item.tags ?? [])]
            .join(' ')
            .toLowerCase();
          return haystack.includes(q);
        })
      : all.slice(0, 8);

    activeIndex = current.length ? 0 : -1;
    results.replaceChildren();

    if (loading) {
      const p = document.createElement('p');
      p.className = 'search-empty';
      p.textContent = labels.loading;
      results.append(p);
      return;
    }

    if (!current.length) {
      const p = document.createElement('p');
      p.className = 'search-empty';
      p.textContent = q ? `${labels.empty} “${query}”` : labels.empty;
      results.append(p);
      return;
    }

    current.forEach((item, index) => {
      const link = document.createElement('a');
      link.className = 'search-result';
      link.href = item.href;
      link.setAttribute('role', 'option');
      link.dataset.index = String(index);

      const title = document.createElement('span');
      title.className = 'search-result-title';
      title.textContent = item.title;

      const meta = document.createElement('span');
      meta.className = 'search-result-meta';
      meta.textContent = typeLabel(item);

      link.append(title, meta);
      results.append(link);
    });

    updateActive();
  };

  const updateActive = () => {
    if (!results) return;
    results.querySelectorAll<HTMLElement>('.search-result').forEach((el, index) => {
      el.classList.toggle('is-active', index === activeIndex);
      el.setAttribute('aria-selected', String(index === activeIndex));
    });
  };

  const load = async () => {
    if (items || loading) return;
    loading = true;
    render(input?.value ?? '');
    try {
      const response = await fetch('/search.json');
      if (!response.ok) throw new Error('search index failed');
      items = (await response.json()) as SearchItem[];
    } catch {
      items = [];
    } finally {
      loading = false;
      render(input?.value ?? '');
    }
  };

  const open = () => {
    if (!dialog) return;
    if (!dialog.open) dialog.showModal();
    input?.focus();
    load();
  };

  document.querySelectorAll<HTMLElement>('[data-search-open]').forEach((button) => {
    button.addEventListener('click', open);
  });

  input?.addEventListener('input', () => render(input.value));

  input?.addEventListener('keydown', (event) => {
    if (!current.length) return;
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      activeIndex = (activeIndex + 1) % current.length;
      updateActive();
      results?.querySelectorAll<HTMLElement>('.search-result')[activeIndex]?.scrollIntoView({ block: 'nearest' });
    }
    if (event.key === 'ArrowUp') {
      event.preventDefault();
      activeIndex = (activeIndex - 1 + current.length) % current.length;
      updateActive();
      results?.querySelectorAll<HTMLElement>('.search-result')[activeIndex]?.scrollIntoView({ block: 'nearest' });
    }
    if (event.key === 'Enter' && activeIndex >= 0) {
      event.preventDefault();
      window.location.href = current[activeIndex].href;
    }
  });

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  window.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement;
    const isTyping =
      target.tagName === 'INPUT' ||
      target.tagName === 'TEXTAREA' ||
      target.isContentEditable;

    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      open();
      return;
    }

    if (event.key === '/' && !isTyping) {
      event.preventDefault();
      open();
    }
  });
</script>