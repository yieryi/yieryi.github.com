---
import type { CollectionEntry } from 'astro:content';
import CoverArt from './CoverArt.astro';
import Icon from './Icon.astro';
import { localizePath, type Lang } from '../i18n/utils';

interface Props {
  project: CollectionEntry<'projects'> | CollectionEntry<'projectsEn'>;
  lang: Lang;
}

const { project, lang } = Astro.props;
const { data } = project;
const title = lang === 'en' ? (data.titleEn ?? data.title) : data.title;
const summary = lang === 'en' ? (data.summaryEn ?? data.summary) : data.summary;
const role = lang === 'en' ? (data.roleEn ?? data.role) : data.role;
const period = lang === 'en' ? (data.periodEn ?? data.period) : data.period;
---

<article class="project-card">
  <a href={localizePath(`/work/${project.id}/`, lang)}>
    <CoverArt variant={data.cover} label={`${period} / ${role}`} />
    <div class="project-card-body">
      <div class="project-meta">
        <span>{role}</span>
        <span>{period}</span>
      </div>
      <h3 class="project-title">{title}</h3>
      <p class="project-summary">{summary}</p>
      <div class="project-stack">
        {data.stack.slice(0, 4).map((item) => <span class="tag">{item}</span>)}
      </div>
      <span class="project-arrow">
        {lang === 'zh' ? '查看案例' : 'View case study'}
        <Icon name="arrow-up-right" size={14} />
      </span>
    </div>
  </a>
</article>