---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { localizePath, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  zh: {
    eyebrow: '关于 · 萧安',
    title: '萧安<br />三维地理空间工程师',
    lead: '把真实世界，变成可计算、可渲染的三维地图。关注三维渲染、GIS 几何与高精地图数据生产。',
    tags: ['3D Rendering', 'GIS Geometry', 'HD Map', 'Data Production'],
    intro1a: '我是萧安，一名',
    intro1b: '三维地理空间工程师',
    intro1c: '。关注三维渲染引擎、GIS 几何计算、三维建模与高精地图数据生产。',
    intro2:
      '我喜欢把渲染、几何与数据生产放在同一个系统里思考：从数据如何组织，到几何如何计算，再到最终如何被渲染和交互。',
    intro3:
      '这个站点用来记录工程实践、整理技术笔记，也放一些空间计算的小工具。',
    glance: '概览',
    focus: [
      { label: '关注方向', value: '3D 渲染 / GIS 几何 / 高精地图' },
      { label: '常用技术', value: 'C++ / TypeScript / WebGL / Cesium' },
      { label: '网络标识', value: 'WANGKANG' },
      { label: '内容', value: '技术笔记 / 项目复盘 / 小工具' },
    ],
    capEyebrow: '01 · Capabilities',
    capTitle: '关注的问题',
    capDesc: '不追求“什么都会”，更在意能不能把一个问题从数据、算法、渲染到交付串起来。',
    contactEyebrow: '02 · Contact',
    contactTitle: '交流与反馈',
    contactDesc: '技术交流、问题反馈、合作想法，欢迎在 GitHub 留言。',
    github: 'GitHub',
    guestbook: '留言板',
    rss: 'RSS',
  },
  en: {
    eyebrow: 'About · XIAO AN',
    title: 'XIAO AN<br />3D Geospatial Engineer',
    lead: 'Turning the real world into computable, renderable 3D maps. Focused on 3D rendering, GIS geometry and HD map data production.',
    tags: ['3D Rendering', 'GIS Geometry', 'HD Map', 'Data Production'],
    intro1a: "I'm XIAO AN, a ",
    intro1b: '3D geospatial engineer',
    intro1c: '. I focus on rendering engines, GIS geometry, 3D modeling and HD map data production.',
    intro2:
      'I like thinking about rendering, geometry and data production as one system: how data is organized, how geometry is computed, and how it finally renders and responds.',
    intro3:
      'This site is where I document engineering practice, keep technical notes and publish a few spatial utilities.',
    glance: 'At a glance',
    focus: [
      { label: 'Focus', value: '3D rendering / GIS geometry / HD map' },
      { label: 'Toolbox', value: 'C++ / TypeScript / WebGL / Cesium' },
      { label: 'Handle', value: 'WANGKANG' },
      { label: 'Content', value: 'Notes / case studies / utilities' },
    ],
    capEyebrow: '01 · Capabilities',
    capTitle: 'Problems I care about',
    capDesc: 'I do not aim to do everything. I care about connecting data, algorithms, rendering and delivery into one working system.',
    contactEyebrow: '02 · Contact',
    contactTitle: 'Exchange and feedback',
    contactDesc: 'Technical exchange, feedback and collaboration ideas are welcome via GitHub.',
    github: 'GitHub',
    guestbook: 'Guestbook',
    rss: 'RSS',
  },
} as const;

const capabilities = {
  zh: [
    { title: '3D Rendering', desc: 'WebGL / GLSL / C++ / OpenGL，材质、光照、后处理、粒子与大规模场景性能。' },
    { title: 'GIS Geometry', desc: '空间分析、几何编辑、交并差、天际线、剖面、管线与内涝模拟。' },
    { title: 'HD Map & 3D', desc: '高精地图生产工具、三维模型半自动生产、质量校验与工具链。' },
    { title: 'Engineering', desc: 'TypeScript / Node.js / 数据生产系统 / 工具链建设。' },
  ],
  en: [
    { title: '3D Rendering', desc: 'WebGL / GLSL / C++ / OpenGL: materials, lighting, post-processing, particles and large-scene performance.' },
    { title: 'GIS Geometry', desc: 'Spatial analysis, geometry editing, booleans, skylines, cross-sections, pipelines and flood simulation.' },
    { title: 'HD Map & 3D', desc: 'HD map production tools, semi-automated 3D model production, quality checks and tooling.' },
    { title: 'Engineering', desc: 'TypeScript / Node.js / data production systems / tooling.' },
  ],
} as const;

const c = copy[lang];
const caps = capabilities[lang];
---

<BaseLayout
  lang={lang}
  title="About"
  description={
    lang === 'zh'
      ? '萧安（WANGKANG），三维地理空间工程师。关注三维渲染、GIS 几何与高精地图数据生产。'
      : 'XIAO AN (WANGKANG) — 3D geospatial engineer focused on 3D rendering, GIS geometry and HD map data production.'
  }
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <span class="eyebrow">{c.eyebrow}</span>
      <h1 set:html={c.title} />
      <p>{c.lead}</p>
      <div class="page-hero-meta">
        {c.tags.map((tag) => <span class="tag tag-dark">{tag}</span>)}
      </div>
    </div>
  </section>

  <section class="section section-light">
    <div class="container about-intro reveal">
      <div class="about-intro-text">
        <p>{c.intro1a}<strong>{c.intro1b}</strong>{c.intro1c}</p>
        <p>{c.intro2}</p>
        <p>{c.intro3}</p>
      </div>

      <aside class="about-side">
        <h2>{c.glance}</h2>
        <ul>
          {c.focus.map((item) => (
            <li>
              <span>{item.label}</span>
              <span>{item.value}</span>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head reveal">
        <div class="section-head-copy">
          <span class="eyebrow">{c.capEyebrow}</span>
          <h2 class="section-title">{c.capTitle}</h2>
          <p class="section-desc">{c.capDesc}</p>
        </div>
      </div>

      <div class="cap-grid reveal">
        {caps.map((item, index) => (
          <article class="cap-card">
            <span class="cap-num">0{index + 1}</span>
            <h3 class="cap-title" style="margin-top: 22px;">{item.title}</h3>
            <p class="cap-desc">{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-light" id="contact">
    <div class="container">
      <div class="section-head reveal">
        <div class="section-head-copy">
          <span class="eyebrow">{c.contactEyebrow}</span>
          <h2 class="section-title">{c.contactTitle}</h2>
          <p class="section-desc">{c.contactDesc}</p>
        </div>
      </div>

      <div class="contact-list reveal" style="max-width: 820px;">
        <div class="contact-item">
          <span>{c.github}</span>
          <a href={site.github} target="_blank" rel="noopener noreferrer">@yieryi</a>
        </div>
        <div class="contact-item">
          <span>{c.guestbook}</span>
          <a href={site.githubIssues} target="_blank" rel="noopener noreferrer">GitHub Issues</a>
        </div>
        <div class="contact-item">
          <span>{c.rss}</span>
          <a href={localizePath('/rss.xml', lang)}>RSS</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>