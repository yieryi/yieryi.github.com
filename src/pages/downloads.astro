---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { downloads } from '../data/downloads';

const isPage = (file: string) => file.endsWith('/');
---

<BaseLayout
  title="Downloads"
  description="王康（WANGKANG）的简历、示例数据、Cesium 演示视频与工具资源下载。"
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <span class="eyebrow">Downloads · Resources</span>
      <h1>一些可以直接拿走的东西。</h1>
      <p>
        简历、示例数据、演示视频和工具索引。文件尽量保持小而有用；
        较大的资源后续会放到 GitHub Releases。
      </p>
      <div class="page-hero-meta">
        <span class="tag tag-dark">{downloads.length} 个资源</span>
        <span class="tag tag-dark">GeoJSON / JSON / MP4 / PDF</span>
        <span class="tag tag-dark">持续更新</span>
      </div>
    </div>
  </section>

  <section class="page-body">
    <div class="container">
      <div class="section-head reveal">
        <div class="section-head-copy">
          <span class="eyebrow">01 · Files</span>
          <h2 class="section-title">资源列表</h2>
          <p class="section-desc">
            每个文件都标注类型、大小、版本和 SHA256。下载后可自行校验完整性。
          </p>
        </div>
      </div>

      <div class="download-grid">
        {downloads.map((item) => (
          <article class="download-card reveal">
            <div class="download-card-top">
              <span class="download-type">{item.type}</span>
              <span class="tag">v{item.version}</span>
            </div>

            <h3 class="download-title">{item.title}</h3>
            <p class="download-desc">{item.description}</p>

            <dl class="download-meta">
              <div>
                <dt>Size</dt>
                <dd>{item.size}</dd>
              </div>
              <div>
                <dt>Updated</dt>
                <dd>{item.updated}</dd>
              </div>
              <div>
                <dt>Type</dt>
                <dd>{item.type}</dd>
              </div>
            </dl>

            {item.sha256 && (
              <p class="download-hash">SHA256: {item.sha256.slice(0, 24)}…</p>
            )}

            <div class="download-tags">
              {item.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>

            <a
              class="download-action"
              href={item.file}
              download={isPage(item.file) ? undefined : ''}
            >
              <span>{item.actionLabel ?? (isPage(item.file) ? '打开' : '下载')}</span>
              <Icon name={isPage(item.file) ? 'arrow-up-right' : 'download'} size={15} />
            </a>
          </article>
        ))}
      </div>

      <div class="download-note reveal">
        <strong>关于大文件：</strong>
        超过 20MB 的资源建议放在 GitHub Releases，而不是直接提交到仓库。
        这样既不会拖慢构建，也方便版本管理和回滚。
        如果你需要某个示例的原始工程或数据，可以邮件联系。
      </div>
    </div>
  </section>
</BaseLayout>